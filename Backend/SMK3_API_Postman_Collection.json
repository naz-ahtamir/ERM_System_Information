    {
      "name": "Findings - CRUD",
      "item": [
        {
          "name": "Create Finding",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('finding_id', jsonData.id);",
                  "  console.log('✓ Finding created with ID: ' + jsonData.id);",
                  "} else {",
                  "  console.log('✗ Failed to create finding');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subSubElementId\": \"7-1-1\",\n  \"title\": \"Inspeksi Ketidaksesuaian - Lokasi 140 HEKTAR\",\n  \"data\": {\n    \"lokasi\": \"140 HEKTAR\",\n    \"severity\": \"high\",\n    \"department\": \"Production\",\n    \"description\": \"Temuan keselamatan di area 140 hektar\",\n    \"tanggal\": \"2024-01-15\"\n  },\n  \"files\": []\n}"
            },
            "url": {
              "raw": "http://localhost:3001/api/smk3-data",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "api",
                "smk3-data"
              ]
            }
          }
